# Frontend (Vite) environment variables
# Leave empty to use Vite dev proxy (/api -> http://localhost:8000)
VITE_API_BASE_URL=

# Firebase client config (optional cloud sync). These are public client identifiers;
# restrict usage in Firebase/Google Cloud console.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Optional AI integration (if used by server-side features)
GEMINI_API_KEY=
APP_URL=
